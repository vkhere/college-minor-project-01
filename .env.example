# ==============================================================================
# Environment Configuration Template (.env.example)
# Rename this file to .env and fill in your actual credentials.
# NEVER commit the real .env file with actual credentials to GitHub!
# ==============================================================================

# 1. NVIDIA AI Foundation Endpoints API Key (Required for English email composition)
# Get a free developer API key with cloud credits at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=google/diffusiongemma-26b-a4b-it

# 2. Gmail SMTP Credentials (Optional - only needed for real email dispatch)
# IMPORTANT: For security, use a 16-character Google App Password (NOT your login password).
# Enable 2-Step Verification, then generate an App Password at:
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password_here

# Optional: Default SMTP Server & Port (Defaults to Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
